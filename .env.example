# AWS Infrastructure
AWS_PRIMARY_ACCOUNT_ID=your-aws-account-id
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=your-cluster-name
EKS_OIDC_PROVIDER_ID=your-oidc-provider-id

# CloudWatch Exporter - Cross-account IDs
CLOUDWATCH_ACCOUNT_PERFADMIN=your-perfadmin-account-id
CLOUDWATCH_ACCOUNT_PREPROD=your-preprod-account-id
CLOUDWATCH_ACCOUNT_SERVERLESS_PROD=your-serverless-prod-account-id
CLOUDWATCH_ACCOUNT_SERVERLESS_BETA=your-serverless-beta-account-id

# ALB Ingress
ALB_ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:your-account-id:certificate/your-cert-id
GRAFANA_INGRESS_HOST=grafana.your-domain.com
GREPTIMEDB_INGRESS_HOST=greptimedb.your-domain.com

# GreptimeDB
GREPTIMEDB_S3_BUCKET=your-greptimedb-storage-bucket
GREPTIMEDB_USERNAME=your-greptimedb-username
GREPTIMEDB_PASSWORD=your-greptimedb-password

# Grafana Admin
GRAFANA_ADMIN_USERNAME=your-grafana-admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# POC Cost Exporter - Source Grafana (customer Mimir access)
POC_EXPORTER_GRAFANA_URL=https://your-customer-grafana.example.com
POC_EXPORTER_GRAFANA_USERNAME=your-customer-grafana-username
POC_EXPORTER_GRAFANA_PASSWORD=your-customer-grafana-password

# Vantage Cost Exporter
VANTAGE_API_TOKEN=your-vantage-api-token
