// =============================================================================
// Remote Write Endpoint - One database per cluster
// =============================================================================

prometheus.remote_write "greptimedb_cluster" {
  endpoint {
    url = "{{GREPTIMEDB_URL}}/v1/prometheus/write?db={{CLUSTER_DATABASE}}"
    basic_auth {
      username = "{{GREPTIMEDB_USERNAME}}"
      password = "{{GREPTIMEDB_PASSWORD}}"
    }
  }
}

// =============================================================================
// Exporter Heartbeat - Self-monitoring metrics
// =============================================================================
prometheus.exporter.self "cloudcosts_agent" {}

prometheus.scrape "alloy_self" {
  targets    = prometheus.exporter.self.cloudcosts_agent.targets
  forward_to = [prometheus.relabel.heartbeat.receiver]
  scrape_interval = "1m"
  job_name = "cloudcosts-agent-self"
}

prometheus.relabel "heartbeat" {
  forward_to = [prometheus.remote_write.greptimedb_system.receiver]

  rule {
    source_labels = ["__name__"]
    regex = "up"
    action = "keep"
  }
  rule {
    source_labels = ["__name__"]
    regex = "up"
    replacement = "exporter_heartbeat"
    target_label = "__name__"
  }
  rule {
    target_label = "exporter"
    replacement = "cloudcosts-agent"
  }
}

prometheus.remote_write "greptimedb_system" {
  endpoint {
    url = "{{GREPTIMEDB_URL}}/v1/prometheus/write?db=system"
    basic_auth {
      username = "{{GREPTIMEDB_USERNAME}}"
      password = "{{GREPTIMEDB_PASSWORD}}"
    }
  }
  external_labels = {
    cluster = "{{CLUSTER_DATABASE}}",
  }
}
