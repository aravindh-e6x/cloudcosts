network_region_egress_cost|kubecost_network_zone_egress_cost|kubecost_node_is_spot|kubecost_pv_info|kubelet_active_pods|kubelet_desired_pods|kubelet_running_containers|kubelet_running_pods|kubernetes_build_info|kubernetes_feature_enabled|node_cpu_guest_seconds_total|node_cpu_hourly_cost|node_cpu_seconds_total|node_gpu_count|node_gpu_hourly_cost|node_memory_Active_anon_bytes|node_memory_Active_bytes|node_memory_Active_file_bytes|node_memory_AnonHugePages_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_memory_MemTotal_bytes|node_network_info|node_ram_hourly_cost|node_total_hourly_cost|opencost_build_info"
