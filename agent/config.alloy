// =============================================================================
// CloudCosts Agent - Alloy Configuration
// =============================================================================

// Scrape kube-state-metrics
prometheus.scrape "kube_state_metrics" {
  targets = [{
    __address__ = "{{RELEASE_NAME}}-kube-state-metrics.{{RELEASE_NAMESPACE}}.svc:8080",
  }]
  forward_to = [prometheus.relabel.all_metrics.receiver]
  scrape_interval = "30s"
  job_name = "kube-state-metrics"
}

// Scrape node-exporter
discovery.kubernetes "nodes" {
  role = "node"
}

discovery.relabel "node_exporter" {
  targets = discovery.kubernetes.nodes.targets
  rule {
    replacement = "{{RELEASE_NAME}}-prometheus-node-exporter.{{RELEASE_NAMESPACE}}.svc:9100"
    target_label = "__address__"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label = "node"
  }
}

prometheus.scrape "node_exporter" {
  targets = discovery.relabel.node_exporter.output
  forward_to = [prometheus.relabel.all_metrics.receiver]
  scrape_interval = "30s"
  job_name = "node-exporter"
}

// Scrape pods with prometheus.io/scrape annotation
discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex = "true"
    action = "keep"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scheme"]
    regex = "(https?)"
    target_label = "__scheme__"
    replacement = "$1"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    regex = "(.+)"
    target_label = "__metrics_path__"
    replacement = "$1"
  }
  rule {
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    regex = "([^:]+)(?:\\d+)?;(\\d+)"
    target_label = "__address__"
    replacement = "$1:$2"
  }
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label = "namespace"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label = "pod"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label = "container"
  }
  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label = "node"
  }
}

prometheus.scrape "pods" {
  targets = discovery.relabel.pods.output
  forward_to = [prometheus.relabel.all_metrics.receiver]
  scrape_interval = "30s"
  job_name = "kubernetes-pods"
}

// Scrape kubelet metrics
discovery.relabel "kubelet" {
  targets = discovery.kubernetes.nodes.targets
  rule {
    target_label = "__address__"
    replacement = "kubernetes.default.svc:443"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex = "(.+)"
    target_label = "__metrics_path__"
    replacement = "/api/v1/nodes/$1/proxy/metrics"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label = "node"
  }
}

prometheus.scrape "kubelet" {
  targets = discovery.relabel.kubelet.output
  forward_to = [prometheus.relabel.all_metrics.receiver]
  scrape_interval = "30s"
  job_name = "kubelet"
  scheme = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = true
  }
}

// Scrape cAdvisor metrics
discovery.relabel "cadvisor" {
  targets = discovery.kubernetes.nodes.targets
  rule {
    target_label = "__address__"
    replacement = "kubernetes.default.svc:443"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex = "(.+)"
    target_label = "__metrics_path__"
    replacement = "/api/v1/nodes/$1/proxy/metrics/cadvisor"
  }
  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label = "node"
  }
}

prometheus.scrape "cadvisor" {
  targets = discovery.relabel.cadvisor.output
  forward_to = [prometheus.relabel.all_metrics.receiver]
  scrape_interval = "30s"
  job_name = "cadvisor"
  scheme = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  tls_config {
    ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = true
  }
}

// Scrape OpenCost metrics
prometheus.scrape "opencost" {
  targets = [{
    __address__ = "{{RELEASE_NAME}}-opencost.{{RELEASE_NAMESPACE}}.svc:9003",
  }]
  forward_to = [prometheus.relabel.all_metrics.receiver]
  scrape_interval = "30s"
  job_name = "opencost"
  metrics_path = "/metrics"
}

// =============================================================================
// Metric Routing - Whitelist only essential metrics
// =============================================================================

prometheus.relabel "all_metrics" {
  forward_to = [prometheus.remote_write.greptimedb_cluster.receiver]

  // Whitelist - keep only essential metrics
  rule {
    source_labels = ["__name__"]
    regex = "container_cpu_cfs_periods_total|container_cpu_cfs_throttled_periods_total|container_cpu_cfs_throttled_seconds_total|container_cpu_system_seconds_total|container_cpu_usage_seconds_total|container_memory_allocation_bytes|container_network_receive_bytes_total|container_network_transmit_bytes_total|io_e6x_e6engine_avgfilesizeinbytes|io_e6x_e6engine_columnsplitfilesreadfromcachebytes_created|io_e6x_e6engine_columnsplitfilesreadfromcachebytes_total|io_e6x_e6engine_columnsplitfilesreadfroms3bytes_created|io_e6x_e6engine_columnsplitfilesreadfroms3bytes_total|io_e6x_e6engine_columnsplitfilesreadfroms3compressed_created|io_e6x_e6engine_columnsplitfilesreadfroms3compressed_total|io_e6x_e6engine_cumulativenumberofproducernodesclosed_created|io_e6x_e6engine_cumulativenumberofproducernodesclosed_total|io_e6x_e6engine_cumulativenumberofproducernodescreated_created|io_e6x_e6engine_cumulativenumberofproducernodescreated_total|io_e6x_e6engine_cumulativenumberofproducernodesexception_created|io_e6x_e6engine_cumulativenumberofproducernodesexception_total|io_e6x_e6engine_cumulativetimetakentocloseproducernodes_created|io_e6x_e6engine_cumulativetimetakentocloseproducernodes_total|io_e6x_e6engine_currentactivee6connections|io_e6x_e6engine_currentactivetasks|io_e6x_e6engine_currentactivetasksaborted|io_e6x_e6engine_currentactivetaskscancelled|io_e6x_e6engine_currentactivetasksfailed|io_e6x_e6engine_currentactivetasksnew|io_e6x_e6engine_currentactivetasksrunning|io_e6x_e6engine_currentactivetaskssucceeded|io_e6x_e6engine_currentdynamicrssbytes|io_e6x_e6engine_currentexecutorallocatedmemorybytes|io_e6x_e6engine_currentexecutoroccupiedmemorybytes|io_e6x_e6engine_currentexecutorusedmemorybytes|io_e6x_e6engine_currentfreerssbytes|io_e6x_e6engine_currentmemcacheavailableslots|io_e6x_e6engine_currentmemcachememorybytes|io_e6x_e6engine_currentmemcacheoccupiedslots|io_e6x_e6engine_currentmemcachepinnedslots|io_e6x_e6engine_currentmemcachereclaimedslots|io_e6x_e6engine_currentmmappinned