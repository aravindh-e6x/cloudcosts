      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "name": "GreptimeDB-Vantage-SQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  account_name as \"Account\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 1 THEN greptime_value ELSE 0 END) as \"Jan\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 2 THEN greptime_value ELSE 0 END) as \"Feb\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 3 THEN greptime_value ELSE 0 END) as \"Mar\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 4 THEN greptime_value ELSE 0 END) as \"Apr\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 5 THEN greptime_value ELSE 0 END) as \"May\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 6 THEN greptime_value ELSE 0 END) as \"Jun\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 7 THEN greptime_value ELSE 0 END) as \"Jul\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 8 THEN greptime_value ELSE 0 END) as \"Aug\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 9 THEN greptime_value ELSE 0 END) as \"Sep\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 10 THEN greptime_value ELSE 0 END) as \"Oct\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 11 THEN greptime_value ELSE 0 END) as \"Nov\",\n  SUM(CASE WHEN EXTRACT(YEAR FROM greptime_timestamp) = EXTRACT(YEAR FROM $__timeTo()) AND EXTRACT(MONTH FROM greptime_timestamp) = 12 THEN greptime_value ELSE 0 END) as \"Dec\"\nFROM vantage_daily_cost_by_account\nWHERE $__timeFilter(greptime_timestamp)\nGROUP BY account_name\nORDER BY account_name;",
          "refId": "A",
          "sql": {
